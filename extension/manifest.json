{
  "manifest_version": 3,
  "name": "E-Learn: save words",
  "short_name": "E-Learn",
  "version": "1.0.0",
  "description": "Select an English word on any page and save it, with its sentence, to your E-Learning notes.",
  "permissions": ["contextMenus", "storage", "activeTab", "scripting"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "E-Learn: save words",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "options_page": "options.html",
  "commands": {
    "save-selection": {
      "suggested_key": { "default": "Alt+Shift+N" },
      "description": "Save the selected word to E-Learn notes"
    }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
