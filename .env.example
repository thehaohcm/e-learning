# Copy to .env and fill in. Never commit .env.

# ---- PostgreSQL (runs in docker-compose as the "db" service)
# On the first start the db container creates this user and database.
# Changing them later does NOT change an existing database volume.
DB_USER=elearn
DB_PASSWORD=change-me-strong-password
DB_NAME=elearn
DB_SSLMODE=disable
# DB_HOST/DB_PORT are set to db:5432 by docker-compose. DB_HOST here is only
# used by `make api-dev` and as the SSH fallback in deploy.sh.
DB_HOST=your-server-ip
DB_PORT=5432

# ---- API
APP_ENV=production
# At least 32 random characters, e.g. output of: openssl rand -hex 32
JWT_SECRET=
# Comma-separated emails that get admin rights (manage decks, AI generation).
# If empty, the first account created becomes admin.
ADMIN_EMAILS=you@example.com
# Set to false after creating your account to stop strangers from signing up.
OPEN_SIGNUP=true
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
# Only needed if the web app is served from a different origin than the API.
CORS_ORIGINS=http://localhost:8085,http://localhost:8080

# ---- AI (optional: card generation and writing feedback)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---- Domain (only used in deploy.sh messages; the proxy serves any host name)
APP_DOMAIN=learn.example.com

# ---- deploy.sh (SSH target; falls back to DB_HOST / DB_USER)
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_REMOTE_DIR=
